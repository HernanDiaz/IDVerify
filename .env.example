# Copy to .env and adjust. docker-compose reads this file.

# --- API ---
APP_NAME=DocVerify API
ENVIRONMENT=development

# --- PostgreSQL (async driver for the API, sync psycopg is derived for Alembic/worker) ---
DATABASE_URL=postgresql+asyncpg://docverify:docverify@db:5432/docverify

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
# Optional explicit overrides (default to REDIS_URL):
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Model ---
# Path to the trained weights INSIDE the container (mounted via docker-compose).
MODEL_WEIGHTS_PATH=/models/model_multitask_seed47.pt
# Set to true to skip loading PyTorch and use a deterministic fake predictor
# (used by the fast test suite; never in production).
USE_MOCK_MODEL=false
INPUT_SIZE=224
# CPU inference thread count (see README performance notes).
TORCH_NUM_THREADS=1

# --- Storage (filesystem, NOT the database) ---
UPLOAD_DIR=/data/uploads
MASK_DIR=/data/masks

# --- Upload validation ---
MAX_UPLOAD_BYTES=10485760

# --- Privacy: automatic deletion of images and masks ---
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
